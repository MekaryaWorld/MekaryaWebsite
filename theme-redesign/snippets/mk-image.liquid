{%- doc -%}
  Renders a picked image, or falls back to a file uploaded under Content > Files.

  @param {image} [image] - Image from an image_picker setting
  @param {string} [fallback] - Filename in Content > Files, e.g. "mekarya-rx8-front.jpg"
  @param {string} [alt] - Alt text (defaults to the image's own alt)
  @param {string} [sizes] - Sizes attribute
  @param {string} [loading] - "lazy" (default) or "eager"
  @param {string} [class] - Class for the img element
{%- enddoc -%}
{%- liquid
  assign img = image
  if img == blank and fallback != blank
    assign img = images[fallback]
  endif
  assign img_alt = alt | default: img.alt | escape
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
-%}
{%- if img != blank -%}
  {%- if img_loading == 'eager' -%}
    {{ img | image_url: width: 2400 | image_tag: widths: '480, 720, 960, 1200, 1600, 2000, 2400', sizes: img_sizes, alt: img_alt, class: class, preload: true, fetchpriority: 'high' }}
  {%- else -%}
    {{ img | image_url: width: 2400 | image_tag: widths: '360, 480, 720, 960, 1200, 1600', sizes: img_sizes, alt: img_alt, class: class, loading: 'lazy' }}
  {%- endif -%}
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'mk-placeholder' }}
{%- endif -%}
