{%- render 'mk-assets' -%}
<div class="mk">
  <section class="mk-section mk-builds" aria-labelledby="mk-builds-title-{{ section.id }}">
    <div class="mk-wrap">
      <div class="mk-builds__head" data-mk-reveal>
        <h2 id="mk-builds-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="mk-tri" data-mk-reveal>
        {%- for block in section.blocks -%}
          <figure{% if forloop.index == 2 %} class="mk-tri__mid"{% endif %} {{ block.shopify_attributes }}>
            {%- render 'mk-image', image: block.settings.image, fallback: block.settings.image_file, alt: block.settings.caption, sizes: '(min-width: 750px) 40vw, 100vw' -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Mekarya customer builds",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer builds" },
    { "type": "textarea", "id": "text", "label": "Sentence", "default": "Custom designs on customers' own cars, drawn and made by Mekarya." }
  ],
  "blocks": [
    {
      "type": "build",
      "name": "Build photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_file", "label": "Fallback file name (Content > Files)" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Mekarya customer builds",
      "blocks": [
        { "type": "build", "settings": { "image_file": "mekarya-civic-fd.jpg", "caption": "Honda Civic FD" } },
        { "type": "build", "settings": { "image_file": "mekarya-black-vents.jpg", "caption": "Vented fenders, custom design" } },
        { "type": "build", "settings": { "image_file": "mekarya-civic-front.jpg", "caption": "Honda Civic EK" } }
      ]
    }
  ]
}
{% endschema %}
