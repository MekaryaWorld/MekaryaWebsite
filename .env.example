# Copy to .env (shopify app dev fills in the SHOPIFY_* values for you).

# --- Email (any SMTP provider: Gmail app password, Resend, Postmark, SendGrid, Mailgun...) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
# The "from" address customers see. Must be allowed by your SMTP provider.
EMAIL_FROM="Mekarya Builds <builds@yourdomain.com>"
# Optional: where customer replies go
EMAIL_REPLY_TO=

# Public storefront URL of the tracker page (used for links inside emails)
TRACKER_URL=https://your-store.com/apps/build-status
